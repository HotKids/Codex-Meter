<?xml version="1.0" encoding="utf-8"?>
<!--
    Codex usage widget. One-row cells (2x1, 4x1) keep upstream's One UI dials; larger cells show
    the AI-Usage style usage card. The default size is the 2x2 small card.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:description="@string/widget_description"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_card"
    android:configure="dev.bennett.codexmeter.WidgetConfigActivity"
    android:resizeMode="vertical|horizontal"
    android:minResizeWidth="90dp"
    android:minResizeHeight="60dp"
    android:initialKeyguardLayout="@layout/widget_rings"
    android:widgetCategory="keyguard|home_screen"
    android:widgetFeatures="configuration_optional|reconfigurable"
    android:previewLayout="@layout/widget_card"
    android:maxResizeWidth="720dp"
    android:maxResizeHeight="480dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    app:previewLayoutExtraLarge="@layout/widget_card"
    app:previewLayoutExtraLargeLong="@layout/widget_card"
    app:previewLayoutLarge="@layout/widget_card"
    app:previewLayoutMedium="@layout/widget_card"
    app:previewLayoutSmall="@layout/widget_rings"
    app:previewLayoutWideSmall="@layout/widget_rings_four"
    app:widgetSize="extraLargeLong|extraLarge|large|medium|wideSmall|small"
    app:widgetStyle="colorful"/>
