<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material home widget roles. Android 12+ maps them to the wallpaper-derived system
        palette (values-v31); older releases use this fixed blue scheme. The unsuffixed
        roles follow the night mode of whoever resolves them (values-night aliases).
    -->
    <color name="widget_material_surface_light">#FFEEF0FF</color>
    <color name="widget_material_panel_light">#FFDCE2F9</color>
    <color name="widget_material_track_light">#FFC0C8E8</color>
    <color name="widget_material_fill_light">#FF475D92</color>
    <color name="widget_material_text_light">#FF1A1B21</color>
    <color name="widget_material_secondary_light">#FF45464F</color>
    <color name="widget_material_accent_light">#FF475D92</color>

    <color name="widget_material_surface_dark">#FF1A1B21</color>
    <color name="widget_material_panel_dark">#FF283041</color>
    <color name="widget_material_track_dark">#FF3E4759</color>
    <color name="widget_material_fill_dark">#FFB0C6FF</color>
    <color name="widget_material_text_dark">#FFE3E2E9</color>
    <color name="widget_material_secondary_dark">#FFC5C6D0</color>
    <color name="widget_material_accent_dark">#FFB0C6FF</color>

    <color name="widget_material_surface">@color/widget_material_surface_light</color>
    <color name="widget_material_panel">@color/widget_material_panel_light</color>
    <color name="widget_material_track">@color/widget_material_track_light</color>
    <color name="widget_material_fill">@color/widget_material_fill_light</color>
    <color name="widget_material_text">@color/widget_material_text_light</color>
    <color name="widget_material_secondary">@color/widget_material_secondary_light</color>
    <color name="widget_material_accent">@color/widget_material_accent_light</color>
</resources>
