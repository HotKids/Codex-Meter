<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews uses platform ImageView, which requires android:tint. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/dial_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_dial_surface" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:orientation="horizontal" android:baselineAligned="false">
        <FrameLayout android:id="@+id/primary_section" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1">
            <FrameLayout android:id="@+id/primary_samsung_progress" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="top|center_horizontal">
                <ImageView android:id="@+id/primary_samsung_track" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_track" />
                <ImageView android:id="@+id/primary_samsung_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_primary" />
            </FrameLayout>
            <ImageView android:id="@+id/primary_samsung_icon" android:layout_width="23dp" android:layout_height="23dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:src="@drawable/ic_oui_time" android:contentDescription="@string/five_hour" android:tint="@color/widget_material_text" />
            <TextView android:id="@+id/primary_samsung_value" android:layout_width="match_parent" android:layout_height="20dp" android:layout_gravity="top" android:layout_marginTop="38dp" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:fontFamily="sec" android:text="@string/widget_sample_primary_value" android:textColor="@color/widget_material_text" android:textStyle="bold" android:textSize="14.5sp" />
            <TextView android:id="@+id/primary_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/primary_reset" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
        </FrameLayout>
        <FrameLayout android:id="@+id/secondary_section" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1">
            <FrameLayout android:id="@+id/secondary_samsung_progress" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="top|center_horizontal">
                <ImageView android:id="@+id/secondary_samsung_track" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_track" />
                <ImageView android:id="@+id/secondary_samsung_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_secondary" />
            </FrameLayout>
            <ImageView android:id="@+id/secondary_samsung_icon" android:layout_width="23dp" android:layout_height="23dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:src="@drawable/ic_oui_calendar_week" android:contentDescription="@string/weekly" android:tint="@color/widget_material_text" />
            <TextView android:id="@+id/secondary_samsung_value" android:layout_width="match_parent" android:layout_height="20dp" android:layout_gravity="top" android:layout_marginTop="38dp" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:fontFamily="sec" android:text="@string/widget_sample_secondary_value" android:textColor="@color/widget_material_text" android:textStyle="bold" android:textSize="14.5sp" />
            <TextView android:id="@+id/secondary_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/secondary_reset" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_title" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/plan_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <ImageView android:id="@+id/refresh_button" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/reset_credit_row" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp">
        <TextView android:id="@+id/reset_credit_info" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/reset_credit_button" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>
    <TextView android:id="@+id/updated_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
</FrameLayout>
