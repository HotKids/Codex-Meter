<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews uses platform ImageView, which requires android:tint. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint,NestedWeights,InefficientWeight" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/dial_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_dial_surface" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <!-- Vertical weights shrink graphics only when space is short; wrap_content keeps tall hosts compact. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/primary_section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:id="@+id/primary_samsung_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1">
                <ImageView android:id="@+id/primary_samsung_track" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:maxWidth="56dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_track" />
                <ImageView android:id="@+id/primary_samsung_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:maxWidth="56dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_primary" />
                <ImageView android:id="@+id/primary_samsung_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:maxWidth="56dp" android:scaleType="fitCenter" android:src="@drawable/widget_dial_icon_session" android:contentDescription="@string/five_hour" android:tint="@color/widget_material_text" />
            </FrameLayout>
            <TextView android:id="@+id/primary_samsung_value" android:layout_width="match_parent" android:layout_height="20sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14.5sp" android:autoSizeStepGranularity="0.5sp" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:fontFamily="sec" android:text="@string/widget_sample_primary_value" android:textColor="@color/widget_material_text" android:textStyle="bold" android:textSize="14.5sp" />
            <TextView android:id="@+id/primary_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/primary_reset" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/secondary_section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:id="@+id/secondary_samsung_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1">
                <ImageView android:id="@+id/secondary_samsung_track" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:maxWidth="56dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_track" />
                <ImageView android:id="@+id/secondary_samsung_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:maxWidth="56dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:src="@drawable/widget_dial_preview_secondary" />
                <ImageView android:id="@+id/secondary_samsung_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:maxWidth="56dp" android:scaleType="fitCenter" android:src="@drawable/widget_dial_icon_weekly" android:contentDescription="@string/weekly" android:tint="@color/widget_material_text" />
            </FrameLayout>
            <TextView android:id="@+id/secondary_samsung_value" android:layout_width="match_parent" android:layout_height="20sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="14.5sp" android:autoSizeStepGranularity="0.5sp" android:gravity="top|center_horizontal" android:includeFontPadding="false" android:fontFamily="sec" android:text="@string/widget_sample_secondary_value" android:textColor="@color/widget_material_text" android:textStyle="bold" android:textSize="14.5sp" />
            <TextView android:id="@+id/secondary_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/secondary_reset" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_title" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <TextView android:id="@+id/plan_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <ImageView android:id="@+id/refresh_button" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/reset_credit_row" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp">
        <TextView android:id="@+id/reset_credit_info" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/reset_credit_button" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>
    <TextView android:id="@+id/updated_label" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
</FrameLayout>
