<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <ProgressBar android:id="@+id/md_refresh_spinner"
        android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:indeterminate="true" android:indeterminateOnly="false"
        android:indeterminateDuration="1000" android:indeterminateBehavior="repeat"
        android:interpolator="@android:interpolator/linear"
        android:indeterminateDrawable="@drawable/widget_refresh_rotation"
        android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp"
        android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
</FrameLayout>
